TICKETINSIGHT_APP_ENV=development
# Docker Compose maps this host port to the application's internal port 8000.
TICKETINSIGHT_APP_PORT=8010
# FastAPI CRUD 运行时：仅 ticketinsight_app，禁止 DDL；不要在生产服务中配置迁移账号。
TICKETINSIGHT_DATABASE_URL=mysql+pymysql://ticketinsight_app:CHANGE_ME@127.0.0.1:3306/ticketinsight
# P2 受控分析执行器：仅 ticketinsight_readonly，禁止 DML/DDL。
TICKETINSIGHT_READONLY_DATABASE_URL=mysql+pymysql://ticketinsight_readonly:CHANGE_ME@127.0.0.1:3306/ticketinsight
# 仅本机 `python scripts/migrate.py upgrade` 使用，必须是 ticketinsight_migrator；FastAPI 与 Agent 永不读取它。
TICKETINSIGHT_MIGRATION_DATABASE_URL=mysql+pymysql://ticketinsight_migrator:CHANGE_ME@127.0.0.1:3306/ticketinsight
TICKETINSIGHT_SQL_MAX_ROWS=200
TICKETINSIGHT_SQL_TIMEOUT_SECONDS=5

# 后续 P1/P3 配置。真实值只写入本机 .env，绝不提交。
# TICKETINSIGHT_QDRANT_URL=http://127.0.0.1:6333
# Previously downloaded model weights. Runtime loading is local-only and never downloads implicitly.
# TICKETINSIGHT_MODEL_CACHE_DIR=D:\\codex项目\\TicketInsight\\.model-cache
# TICKETINSIGHT_DEEPSEEK_API_KEY=
TICKETINSIGHT_DEEPSEEK_BASE_URL=https://api.deepseek.com
TICKETINSIGHT_DEEPSEEK_MODEL=deepseek-v4-flash
# One LLM HTTP call; a timeout becomes a bounded analysis limitation, never an unbounded wait.
TICKETINSIGHT_LLM_TIMEOUT_SECONDS=20
